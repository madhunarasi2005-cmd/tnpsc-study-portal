# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Database Connection String (e.g. MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/tnpsc_study_portal?retryWrites=true&w=majority

# JWT Secret Key for Authentication
JWT_SECRET=your_secure_random_jwt_secret_key_here

# Frontend Application Origin (comma-separated if multiple, e.g. Vercel / Netlify domain)
CLIENT_URL=https://your-study-portal-frontend.vercel.app,http://localhost:5173

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Initial Administrator Seed Account (Auto-created on first startup)
ADMIN_EMAIL=admin@tnpscportal.com
ADMIN_PASSWORD=Admin@123456
